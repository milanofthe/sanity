{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sanity",
  "version": "1.3.0",
  "identifier": "com.milanofthe.sanity",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "sanity",
        "width": 1600,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Transparent",
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
